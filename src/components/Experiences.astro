---
// Catálogo dinámico de experiencias
---

<section id="experiencias" class="experiences relative py-24 bg-gray-50">
  <div class="container relative z-10 max-w-6xl mx-auto px-6 md:px-12 flex flex-col items-center text-center">
    <div class="mb-12 w-full">
      <h2 class="section-title text-6xl md:text-7xl font-black leading-tight mb-4 text-gray-900 text-center">
        EXPERIENCIAS
      </h2>
      <div>
        <div id="experiences-grid" class="feed-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <article
            class="feed-card group relative bg-white border border-gray-200 rounded-lg overflow-hidden p-6 text-center"
          >
            <p class="text-gray-500">Cargando experiencias...</p>
          </article>
        </div>

        <div class="carousel-controls" id="carousel-controls" hidden>
          <button id="carousel-prev" class="carousel-btn" aria-label="Anterior">&#8249;</button>
          <div class="pagination-numbers" id="pagination-numbers"></div>
          <button id="carousel-next" class="carousel-btn" aria-label="Siguiente">&#8250;</button>
        </div>
      </div>
    </div>

    <script>
      import { getExperiences } from "../lib/firebase/database";

      const grid = document.querySelector("#experiences-grid");
      const controls = document.querySelector("#carousel-controls");
      const prevBtn = document.querySelector("#carousel-prev");
      const nextBtn = document.querySelector("#carousel-next");
      const paginationContainer = document.querySelector("#pagination-numbers");
      const fallbackImage = "/assets/experiences/experiencia-ejemplo1.jpg";

      const itemsPerPage = 50;
      let visibleExperiences: Array<{
        uid: string;
        name?: string;
        subtitle?: string;
        description?: string;
        experiencia?: string;
        descripcionDetallada?: string;
        image?: string;
        visible: boolean;
        sortOrder?: number;
        createdAt?: number;
      }> = [];
      let currentSlide = 0;
      let totalSlides = 0;

      const resolveDetailPath = (uid: string) => `/experiencias/${uid}`;

      const updatePaginationButtons = () => {
        document.querySelectorAll(".page-num-btn").forEach((btn, idx) => {
          btn.classList.toggle("active", idx === currentSlide);
        });
        if (prevBtn instanceof HTMLButtonElement) {
          prevBtn.disabled = currentSlide === 0;
        }
        if (nextBtn instanceof HTMLButtonElement) {
          nextBtn.disabled = currentSlide >= totalSlides - 1;
        }
      };

      const renderCurrentPage = () => {
        if (!(grid instanceof HTMLDivElement)) return;

        const start = currentSlide * itemsPerPage;
        const pageItems = visibleExperiences.slice(start, start + itemsPerPage);

        grid.innerHTML = pageItems
          .map((exp) => {
            const title = exp.name || exp.experiencia || "";
            const subtitle = exp.subtitle || "";
            const body = exp.description || exp.descripcionDetallada || "";
            return `
              <article class="feed-card group relative bg-white border border-gray-200 rounded-2xl overflow-hidden hover:border-gray-400 transition-all duration-500 h-full flex flex-col">
                <a href="${resolveDetailPath(exp.uid)}">
                  <div class="card-video relative overflow-hidden bg-white flex-shrink-0">
                    <img
                      src="${exp.image || fallbackImage}"
                      alt="${title}"
                      class="w-full h-auto block transition-transform duration-700"
                    />
                  </div>
                  <div class="card-content p-8 flex flex-col flex-1">
                    <h3 class="text-2xl font-black text-gray-900 mb-1 line-clamp-2">${title}</h3>
                    ${subtitle ? `<p class="text-xs font-semibold text-cyan-600 uppercase tracking-wide mb-3 line-clamp-3">${subtitle}</p>` : ""}
                    <p class="text-sm text-gray-600 line-clamp-4 mb-4">${body}</p>
                    <a
                      href="${resolveDetailPath(exp.uid)}"
                      class="inline-block mt-auto bg-gradient-to-r from-cyan-400 to-fuchsia-500 text-black font-bold px-5 py-2 rounded-full hover:scale-105 transition-transform duration-300 self-start"
                    >Explorar</a>
                  </div>
                </a>
              </article>
            `;
          })
          .join("");

        updatePaginationButtons();
      };

      const goToSlide = (index: number) => {
        currentSlide = Math.max(0, Math.min(index, totalSlides - 1));
        renderCurrentPage();
        if (controls) {
          controls.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }
      };

      const render = async () => {
        if (!(grid instanceof HTMLDivElement)) return;

        try {
          const experiences = await getExperiences();
          visibleExperiences = experiences
            .filter((exp) => exp.visible === true)
            .sort((a, b) => {
              const aOrder = a.sortOrder ?? Infinity;
              const bOrder = b.sortOrder ?? Infinity;
              if (aOrder !== bOrder) return aOrder - bOrder;
              return (b.createdAt ?? 0) - (a.createdAt ?? 0);
            });

          if (!visibleExperiences.length) {
            grid.innerHTML = `
              <article class="feed-card group relative bg-white border border-gray-200 rounded-lg overflow-hidden p-6">
                <p class="text-gray-500">Aún no hay experiencias publicadas.</p>
              </article>
            `;
            return;
          }

          totalSlides = Math.ceil(visibleExperiences.length / itemsPerPage);

          if (paginationContainer instanceof HTMLDivElement) {
            paginationContainer.innerHTML = Array.from({ length: totalSlides })
              .map(
                (_, idx) =>
                  `<button class="page-num-btn${idx === 0 ? " active" : ""}" data-index="${idx}">${idx + 1}</button>`
              )
              .join("");

            paginationContainer.querySelectorAll(".page-num-btn").forEach((btn) => {
              btn.addEventListener("click", (e) => {
                const index = parseInt(
                  (e.target as HTMLElement).getAttribute("data-index") || "0"
                );
                goToSlide(index);
              });
            });
          }

          if (controls instanceof HTMLElement) {
            controls.hidden = totalSlides <= 1;
          }

          renderCurrentPage();
        } catch (error) {
          console.error("Error cargando experiencias:", error);
          if (grid instanceof HTMLDivElement) {
            grid.innerHTML = `
              <article class="feed-card group relative bg-white border border-gray-200 rounded-lg overflow-hidden p-6">
                <p class="text-red-500">No se pudieron cargar las experiencias.</p>
              </article>
            `;
          }
        }
      };

      if (prevBtn instanceof HTMLButtonElement) {
        prevBtn.addEventListener("click", () => goToSlide(currentSlide - 1));
      }
      if (nextBtn instanceof HTMLButtonElement) {
        nextBtn.addEventListener("click", () => goToSlide(currentSlide + 1));
      }

      render();
    </script>

    <style>
      .section-title {
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
      }

      .carousel-controls {
        margin-top: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
      }

      .carousel-btn {
        background: linear-gradient(45deg, #00ffff, #ff00ff);
        color: #000;
        border: none;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        font-size: 1.6rem;
        font-weight: bold;
        line-height: 1;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .carousel-btn:hover:not(:disabled) {
        transform: scale(1.1);
        box-shadow: 0 0 20px rgba(0, 255, 255, 0.45);
      }

      .carousel-btn:disabled {
        opacity: 0.25;
        cursor: not-allowed;
        transform: none;
      }

      .pagination-numbers {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.375rem;
        flex-wrap: wrap;
      }

      .page-num-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 2px solid rgba(0, 0, 0, 0.15);
        background: transparent;
        color: #444;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: inherit;
      }

      .page-num-btn:hover:not(.active) {
        border-color: #00d4e8;
        color: #00b8cc;
        background: rgba(0, 212, 232, 0.08);
      }

      .page-num-btn.active {
        background: linear-gradient(45deg, #00ffff, #ff00ff);
        color: #000;
        border-color: transparent;
        box-shadow: 0 0 14px rgba(0, 255, 255, 0.35);
      }

      @media (max-width: 1024px) {
        .carousel-btn {
          width: 38px;
          height: 38px;
          font-size: 1.4rem;
        }
        .page-num-btn {
          width: 36px;
          height: 36px;
          font-size: 13px;
        }
      }

      @media (max-width: 640px) {
        .carousel-btn {
          width: 34px;
          height: 34px;
          font-size: 1.2rem;
        }
        .page-num-btn {
          width: 32px;
          height: 32px;
          font-size: 12px;
        }
      }
    </style>
  </div>
</section>
