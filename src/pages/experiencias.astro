---
import Layout from '../layouts/Layout.astro';
import Experiences from '../components/Experiences.astro';
import ImplementationModes from '../components/ImplementationModes.astro';
---

<Layout
  title="Catálogo de Experiencias Interactivas para Eventos | Geniality"
  description="Explora nuestro catálogo: tótems táctiles, realidad aumentada, photo booths, gamificación y captura de leads. Experiencias interactivas llave en mano para eventos deportivos y corporativos."
>
	<main class="page-content">
		<section class="hero-section text-center">
			<div class="container flex flex-col items-center text-center">
				<h1>Nuestras Experiencias</h1>
				<p>Descubre las experiencias interactivas que revolucionarán tu venue o evento.</p>
			</div>
		</section>
		<Experiences />
		<ImplementationModes />
	</main>
</Layout>

<style>
	.page-content {
		padding-top: 80px;
	}

	.hero-section {
		background: #f8fafc;
		padding: 5rem 0;
		text-align: center;
		color: #0f172a;
		border-bottom: 1px solid #e2e8f0;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.hero-section h1 {
		font-size: 3rem;
		margin-bottom: 1rem;
	}

	.hero-section p {
		font-size: 1.2rem;
		color: #475569;
	}
</style>