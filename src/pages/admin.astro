---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="admin-page">
    <section class="admin-shell">
      <aside class="sidebar">
        <h1>Admin</h1>
        <button class="side-btn active" data-tab="clientes">Clientes</button>
        <button class="side-btn" data-tab="experiencias">Experiencias</button>
      </aside>

      <section class="content">
        <article id="tab-clientes" class="tab-panel active">
          <h2>Clientes (Leads)</h2>
          <p class="hint">Listado obtenido desde Firebase Firestore.</p>
          <div id="clients-list" class="clients-list"></div>
        </article>

        <article id="tab-experiencias" class="tab-panel">
          <div class="exp-header">
            <div>
              <h2>Experiencias</h2>
              <p class="hint">Tabla de todas las experiencias con acciones de visibilidad, edición y eliminación.</p>
            </div>
            <button id="create-experience-btn" class="btn-create">➕ Crear Experiencia</button>
          </div>

          <p id="experiences-status" class="status" aria-live="polite"></p>

          <table id="experiences-table" class="experiences-table">
            <thead>
              <tr>
                <th class="col-handle"></th>
                <th class="col-image">Imagen</th>
                <th class="col-title">Experiencia</th>
                <th class="col-actions">Acciones</th>
              </tr>
            </thead>
            <tbody id="experiences-list"></tbody>
          </table>
          <p id="experiences-count" class="experiences-count"></p>
        </article>

        <!-- Modal para crear/editar experiencia -->
        <div id="experience-modal" class="modal" hidden>
          <div class="modal-content">
            <div class="modal-header">
              <h3 id="experience-form-title">Crear experiencia</h3>
              <button type="button" class="btn-close" id="modal-close">&times;</button>
            </div>

            <form id="experience-form" class="experience-form">
              <p class="hint">El UID/slug se genera automáticamente al guardar. Solo se publica en catálogo si <code>visible = true</code>.</p>

              <!-- ── Identidad ── -->
              <p class="form-section-title">Identidad</p>
              <div class="field-grid">
                <label>
                  Nombre *
                  <input type="text" name="name" required placeholder="Ej: Raspa y Gana" />
                </label>
                <label>
                  Categoría / Formato *
                  <input type="text" name="formatCategory" required placeholder="Ej: Touch, AR, VR" />
                </label>
                <label>
                  Track
                  <input type="text" name="track" placeholder="Ej: Catalog" />
                </label>
                <label>
                  Origen
                  <input type="text" name="origin" placeholder="Ej: Website" />
                </label>
              </div>

              <!-- ── Tags ── -->
              <p class="form-section-title">Tags <span class="hint-inline">(separados por coma)</span></p>
              <div class="field-grid">
                <label>
                  Tags Interacción
                  <input type="text" name="tagsInteraction" placeholder="Touch Screen, Gesture" />
                </label>
                <label>
                  Tags Vibe
                  <input type="text" name="tagsVibe" placeholder="Casual, Competitivo" />
                </label>
                <label class="field-full">
                  Tags Captura
                  <input type="text" name="tagsCapture" placeholder="Lead Capture, Photo Op" />
                </label>
              </div>

              <!-- ── Contenido ── -->
              <p class="form-section-title">Contenido</p>
              <label>
                Subtítulo <span class="hint-inline">(≤ 80 caracteres)</span>
                <input type="text" name="subtitle" maxlength="80" placeholder="Frase corta que resume la experiencia" />
              </label>
              <label>
                Descripción <span class="hint-inline">(≈ 90 palabras)</span>
                <textarea name="description" rows="4" placeholder="Descripción detallada de la experiencia..."></textarea>
              </label>
              <label>
                Características clave <span class="hint-inline">(una por línea, máx. 4)</span>
                <textarea name="keyFeatures" rows="4" placeholder="Imán de Leads: descripción...&#10;Tráfico Fluido: descripción...&#10;Característica 3...&#10;Característica 4..."></textarea>
              </label>
              <label>
                Add-ons <span class="hint-inline">(separados por punto y coma)</span>
                <textarea name="addons" rows="2" placeholder="Captura de leads con QR; integración CRM; gestión de stock digital"></textarea>
              </label>

              <!-- ── Logística ── -->
              <p class="form-section-title">Logística</p>
              <div class="field-grid">
                <label>
                  Dimensiones
                  <input type="text" name="dimensions" placeholder="Tótem vertical · 1.5 × 1 m" />
                </label>
                <label>
                  Energía
                  <input type="text" name="power" placeholder="1 × 110 V / 15 A" />
                </label>
                <label>
                  Tiempo de montaje
                  <input type="text" name="setupTime" placeholder="1–2 horas" />
                </label>
                <label>
                  Restricciones
                  <input type="text" name="logisticsConstraints" placeholder="Indoor" />
                </label>
                <label>
                  Internet
                  <input type="text" name="internet" placeholder="WiFi recomendado" />
                </label>
                <label>
                  Modalidad
                  <input type="text" name="modality" placeholder="Llave en Mano" />
                </label>
                <label>
                  Capacidad (usuarios/hora)
                  <input type="text" name="capacity" placeholder="~240" />
                </label>
                <label>
                  Duración por sesión
                  <input type="text" name="sessionLength" placeholder="15 s" />
                </label>
              </div>
              <label>
                Equipo incluido
                <textarea name="equipmentIncluded" rows="2" placeholder="Tótem con pantalla táctil, software licenciado..."></textarea>
              </label>

              <!-- ── Media ── -->
              <p class="form-section-title">Media</p>
              <div class="field-grid">
                <label>
                  Imagen principal
                  <div class="image-input-row">
                    <input type="text" name="imageUrl" id="imageUrl" class="image-url-input" placeholder="https://firebasestorage..." />
                    <button type="button" class="btn-upload" id="imageUploadBtn">Subir archivo</button>
                  </div>
                  <input type="file" id="imageFileInput" accept="image/*" class="hidden-file-input" />
                  <span class="upload-hint" id="imageUploadStatus"></span>
                </label>
                <label>
                  Segunda imagen
                  <div class="image-input-row">
                    <input type="text" name="secondImageUrl" id="secondImageUrl" class="image-url-input" placeholder="https://firebasestorage..." />
                    <button type="button" class="btn-upload" id="secondImageUploadBtn">Subir archivo</button>
                  </div>
                  <input type="file" id="secondImageFileInput" accept="image/*" class="hidden-file-input" />
                  <span class="upload-hint" id="secondImageUploadStatus"></span>
                </label>
                <label class="field-full">
                  URL de video
                  <input type="url" name="videoUrl" placeholder="https://..." />
                </label>
              </div>
              <label class="check-row">
                <input type="checkbox" name="photosNeeded" />
                Requiere fotos reales del evento
              </label>

              <!-- ── Configuración ── -->
              <p class="form-section-title">Configuración</p>
              <label class="check-row">
                <input type="checkbox" name="visible" checked />
                Visible en catálogo
              </label>

              <div class="form-actions">
                <button type="submit" class="btn-submit" id="experience-submit-btn">Guardar experiencia</button>
                <button type="button" class="btn-secondary" id="cancel-edit-btn" hidden>Cancelar edición</button>
              </div>
              <p id="experience-form-status" class="status" aria-live="polite"></p>
            </form>
          </div>
        </div>
      </section>
    </section>
  </main>
</Layout>

<script>
  import {
    createExperience,
    deleteExperience,
    getExperiences,
    getLeads,
    toggleExperienceVisibility,
    updateExperience,
    updateSortOrders,
  } from '../lib/firebase/database';
  import { uploadExperienceImage } from '../lib/firebase/storage';

  const tabs = document.querySelectorAll('.side-btn');
  const tabPanels = document.querySelectorAll('.tab-panel');
  const clientsList = document.querySelector('#clients-list');
  const experiencesList = document.querySelector('#experiences-list');
  const experiencesStatus = document.querySelector('#experiences-status');
  const form = document.querySelector('#experience-form');
  const status = document.querySelector('#experience-form-status');
  const formTitle = document.querySelector('#experience-form-title');
  const submitButton = document.querySelector('#experience-submit-btn');
  const cancelEditButton = document.querySelector('#cancel-edit-btn');
  const modal = document.querySelector('#experience-modal');
  const createBtn = document.querySelector('#create-experience-btn');
  const modalCloseBtn = document.querySelector('#modal-close');

  interface AdminExperience {
    uid: string;
    name: string;
    slug?: string;
    formatCategory: string;
    tagsInteraction?: string[];
    tagsVibe?: string[];
    tagsCapture?: string[];
    track?: string;
    origin?: string;
    subtitle?: string;
    description?: string;
    keyFeatures?: string[];
    addons?: string;
    dimensions?: string;
    power?: string;
    setupTime?: string;
    logisticsConstraints?: string;
    internet?: string;
    equipmentIncluded?: string;
    modality?: string;
    capacity?: string;
    sessionLength?: string;
    photosNeeded?: boolean;
    videoUrl?: string;
    image?: string;
    secondImage?: string;
    visible: boolean;
    sortOrder?: number;
    createdAt?: number;
    // Legacy fields
    experiencia?: string;
  }

  let experiencesCache: AdminExperience[] = [];
  let editingUid: string | null = null;

  const slugify = (value: string) =>
    value
      .toLowerCase()
      .trim()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');

  const generateUid = (title: string) => {
    const base = slugify(title) || 'experiencia';
    return `${base}-${Date.now()}`;
  };

  const escapeHtml = (value: string) =>
    value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');

  const getInputByName = (name: string): HTMLInputElement | null => {
    if (!(form instanceof HTMLFormElement)) return null;
    const field = form.elements.namedItem(name);
    return field instanceof HTMLInputElement ? field : null;
  };

  const getTextareaByName = (name: string): HTMLTextAreaElement | null => {
    if (!(form instanceof HTMLFormElement)) return null;
    const field = form.elements.namedItem(name);
    return field instanceof HTMLTextAreaElement ? field : null;
  };

  // Parse comma-separated tag string → array
  const parseTags = (value: string): string[] =>
    value.split(',').map(s => s.trim()).filter(Boolean);

  // Parse newline-separated features → array (max 4)
  const parseFeatures = (value: string): string[] =>
    value.split('\n').map(s => s.trim()).filter(Boolean).slice(0, 4);

  const clearExperienceEditState = () => {
    editingUid = null;
    if (formTitle instanceof HTMLHeadingElement) formTitle.textContent = 'Crear experiencia';
    if (submitButton instanceof HTMLButtonElement) submitButton.textContent = 'Guardar experiencia';
    if (cancelEditButton instanceof HTMLButtonElement) cancelEditButton.hidden = true;
  };

  const openModal = (options?: { resetForm?: boolean }) => {
    const shouldReset = options?.resetForm ?? true;
    if (modal instanceof HTMLElement) {
      modal.hidden = false;
      if (shouldReset && form instanceof HTMLFormElement) {
        form.reset();
        clearExperienceEditState();
      }
    }
  };

  const closeModal = () => {
    if (modal instanceof HTMLElement) {
      modal.hidden = true;
      if (form instanceof HTMLFormElement) {
        form.reset();
        clearExperienceEditState();
        document.querySelectorAll<HTMLElement>('.upload-hint').forEach(el => {
          el.textContent = '';
          el.className = 'upload-hint';
        });
      }
    }
  };

  const populateFormForEdit = (uid: string) => {
    if (!(form instanceof HTMLFormElement)) return;

    const experience = experiencesCache.find((item) => item.uid === uid);
    if (!experience) return;

    editingUid = uid;

    // Helper to set input value safely
    const setInput = (name: string, value: string) => {
      const el = getInputByName(name);
      if (el) el.value = value;
    };
    const setTextarea = (name: string, value: string) => {
      const el = getTextareaByName(name);
      if (el) el.value = value;
    };
    const setCheckbox = (name: string, checked: boolean) => {
      const el = getInputByName(name);
      if (el) el.checked = checked;
    };

    // Identity — support both new and legacy field names
    setInput('name', experience.name || experience.experiencia || '');
    setInput('formatCategory', experience.formatCategory || '');
    setInput('track', experience.track || '');
    setInput('origin', experience.origin || '');

    // Tags — join arrays back to comma-separated strings
    setInput('tagsInteraction', (experience.tagsInteraction ?? []).join(', '));
    setInput('tagsVibe', (experience.tagsVibe ?? []).join(', '));
    setInput('tagsCapture', (experience.tagsCapture ?? []).join(', '));

    // Content
    setInput('subtitle', experience.subtitle || '');
    setTextarea('description', experience.description || '');
    setTextarea('keyFeatures', (experience.keyFeatures ?? []).join('\n'));
    setTextarea('addons', experience.addons || '');

    // Logistics
    setInput('dimensions', experience.dimensions || '');
    setInput('power', experience.power || '');
    setInput('setupTime', experience.setupTime || '');
    setInput('logisticsConstraints', experience.logisticsConstraints || '');
    setInput('internet', experience.internet || '');
    setInput('modality', experience.modality || '');
    setInput('capacity', experience.capacity || '');
    setInput('sessionLength', experience.sessionLength || '');
    setTextarea('equipmentIncluded', experience.equipmentIncluded || '');

    // Media
    setInput('imageUrl', experience.image || '');
    setInput('secondImageUrl', experience.secondImage || '');
    setInput('videoUrl', experience.videoUrl || '');
    setCheckbox('photosNeeded', Boolean(experience.photosNeeded));

    // Settings
    setCheckbox('visible', Boolean(experience.visible));

    if (formTitle instanceof HTMLHeadingElement) {
      formTitle.textContent = `Editar: ${experience.name || experience.experiencia}`;
    }
    if (submitButton instanceof HTMLButtonElement) submitButton.textContent = 'Actualizar experiencia';
    if (cancelEditButton instanceof HTMLButtonElement) cancelEditButton.hidden = false;

    openModal({ resetForm: false });
  };

  const setExperiencesStatus = (message: string, type: 'success' | 'error' = 'success') => {
    if (!(experiencesStatus instanceof HTMLParagraphElement)) return;
    experiencesStatus.classList.remove('success', 'error');
    experiencesStatus.textContent = message;
    experiencesStatus.classList.add(type);
  };

  const experiencesCount = document.querySelector('#experiences-count');

  const renderExperiences = async () => {
    if (!(experiencesList instanceof HTMLTableSectionElement)) return;
    experiencesList.innerHTML = '<tr><td colspan="4" class="hint">Cargando experiencias...</td></tr>';
    if (experiencesCount instanceof HTMLParagraphElement) experiencesCount.textContent = '';

    try {
      const experiences = await getExperiences();

      // Sort by sortOrder; items without it go by createdAt desc
      experiences.sort((a, b) => {
        const aOrder = a.sortOrder ?? Infinity;
        const bOrder = b.sortOrder ?? Infinity;
        if (aOrder !== bOrder) return aOrder - bOrder;
        return (b.createdAt ?? 0) - (a.createdAt ?? 0);
      });

      experiencesCache = experiences;

      if (!experiences.length) {
        experiencesList.innerHTML = '<tr><td colspan="4" class="hint">No hay experiencias registradas aún.</td></tr>';
        return;
      }

      const visibleCount = experiences.filter(e => e.visible).length;
      if (experiencesCount instanceof HTMLParagraphElement) {
        experiencesCount.textContent = `${experiences.length} experiencias en total · ${visibleCount} visibles · ${experiences.length - visibleCount} ocultas`;
      }

      experiencesList.innerHTML = experiences
        .map((experience, index) => {
          const displayName = escapeHtml(experience.name || experience.experiencia || 'Sin nombre');
          const displayCategory = escapeHtml(experience.formatCategory || '');
          return `
            <tr class="exp-row" draggable="true" data-uid="${experience.uid}">
              <td class="col-handle">
                <div class="handle-cell">
                  <span class="drag-handle" title="Arrastrar para reordenar">⠿</span>
                  <span class="order-num">${index + 1}</span>
                </div>
              </td>
              <td class="col-image">
                <img src="${experience.image || '/assets/experiences/experiencia-ejemplo1.jpg'}" alt="${displayName}" class="exp-image" />
              </td>
              <td class="col-title">
                <div class="exp-title">
                  <h4>${displayName}</h4>
                  ${displayCategory ? `<p class="exp-tech">${displayCategory}</p>` : ''}
                </div>
              </td>
              <td class="col-actions">
                <div class="experience-actions">
                  <button type="button" class="btn-row btn-toggle" data-action="toggle" data-uid="${experience.uid}" data-visible="${String(Boolean(experience.visible))}" title="${experience.visible ? 'Ocultar en catálogo' : 'Mostrar en catálogo'}">
                    <span class="btn-icon">${experience.visible ? '👁️' : '🚫'}</span>
                  </button>
                  <button type="button" class="btn-row btn-edit" data-action="edit" data-uid="${experience.uid}" title="Editar información">
                    <span class="btn-icon">✏️</span>
                  </button>
                  <button type="button" class="btn-row btn-delete" data-action="delete" data-uid="${experience.uid}" title="Eliminar experiencia">
                    <span class="btn-icon">🗑️</span>
                  </button>
                </div>
              </td>
            </tr>
          `;
        })
        .join('');

      attachDragHandlers();
    } catch (error) {
      console.error('Error cargando experiencias:', error);
      experiencesList.innerHTML = '<tr><td colspan="4" class="error">No se pudieron cargar las experiencias.</td></tr>';
    }
  };

  const attachDragHandlers = () => {
    if (!(experiencesList instanceof HTMLTableSectionElement)) return;

    let dragSrcUid: string | null = null;

    experiencesList.querySelectorAll<HTMLTableRowElement>('.exp-row').forEach((row) => {
      row.addEventListener('dragstart', (e) => {
        dragSrcUid = row.dataset.uid || null;
        row.classList.add('dragging');
        if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
      });

      row.addEventListener('dragend', () => {
        row.classList.remove('dragging');
        experiencesList.querySelectorAll('.exp-row').forEach(r => r.classList.remove('drag-over'));
      });

      row.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
        if (row.dataset.uid !== dragSrcUid) {
          experiencesList.querySelectorAll('.exp-row').forEach(r => r.classList.remove('drag-over'));
          row.classList.add('drag-over');
        }
      });

      row.addEventListener('dragleave', () => {
        row.classList.remove('drag-over');
      });

      row.addEventListener('drop', async (e) => {
        e.preventDefault();
        row.classList.remove('drag-over');

        const toUid = row.dataset.uid;
        if (!dragSrcUid || !toUid || dragSrcUid === toUid) return;

        const fromIndex = experiencesCache.findIndex(exp => exp.uid === dragSrcUid);
        const toIndex = experiencesCache.findIndex(exp => exp.uid === toUid);
        if (fromIndex === -1 || toIndex === -1) return;

        const reordered = [...experiencesCache];
        const [moved] = reordered.splice(fromIndex, 1);
        reordered.splice(toIndex, 0, moved);

        try {
          await updateSortOrders(reordered.map((exp, i) => ({ uid: exp.uid, sortOrder: i })));
          setExperiencesStatus('Orden actualizado.');
          await renderExperiences();
        } catch (error) {
          setExperiencesStatus(
            error instanceof Error ? error.message : 'No se pudo guardar el orden.',
            'error'
          );
        }
      });
    });
  };

  tabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabs.forEach((b) => b.classList.remove('active'));
      tabPanels.forEach((panel) => panel.classList.remove('active'));
      btn.classList.add('active');
      const panel = document.querySelector(`#tab-${btn.getAttribute('data-tab')}`);
      if (panel) panel.classList.add('active');
    });
  });

  const renderClients = async () => {
    if (!(clientsList instanceof HTMLDivElement)) return;
    clientsList.innerHTML = '<p class="hint">Cargando clientes...</p>';

    try {
      const leads = await getLeads();
      if (!leads.length) {
        clientsList.innerHTML = '<p class="hint">No hay clientes registrados aún.</p>';
        return;
      }
      clientsList.innerHTML = leads
        .map((lead) => `
          <article class="client-card">
            <h3>${lead.name}</h3>
            <p><strong>Email:</strong> ${lead.email}</p>
            <p><strong>Teléfono:</strong> ${lead.phone || 'N/A'}</p>
            <p><strong>Empresa:</strong> ${lead.company || 'N/A'}</p>
            <p><strong>Mensaje:</strong> ${lead.message}</p>
          </article>
        `)
        .join('');
    } catch (error) {
      console.error('Error cargando clientes:', error);
      clientsList.innerHTML = '<p class="error">No se pudieron cargar los clientes.</p>';
    }
  };

  renderClients();
  renderExperiences();

  if (createBtn instanceof HTMLButtonElement) createBtn.addEventListener('click', () => openModal());
  if (modalCloseBtn instanceof HTMLButtonElement) modalCloseBtn.addEventListener('click', closeModal);
  if (modal instanceof HTMLElement) {
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  }
  if (cancelEditButton instanceof HTMLButtonElement && form instanceof HTMLFormElement) {
    cancelEditButton.addEventListener('click', () => {
      form.reset();
      clearExperienceEditState();
      closeModal();
      status?.classList.remove('success', 'error');
      if (status instanceof HTMLParagraphElement) status.textContent = '';
    });
  }

  if (experiencesList instanceof HTMLTableSectionElement) {
    experiencesList.addEventListener('click', async (event) => {
      const target = event.target instanceof HTMLButtonElement
        ? event.target
        : (event.target as HTMLElement).closest('button');
      if (!(target instanceof HTMLButtonElement)) return;

      const action = target.dataset.action;
      const uid = target.dataset.uid;
      if (!action || !uid) return;

      try {
        target.disabled = true;

        if (action === 'toggle') {
          const isVisible = target.dataset.visible === 'true';
          await toggleExperienceVisibility(uid, !isVisible);
          setExperiencesStatus(
            !isVisible ? 'Experiencia marcada como visible.' : 'Experiencia marcada como invisible.'
          );
          await renderExperiences();
          return;
        }

        if (action === 'edit') {
          populateFormForEdit(uid);
          return;
        }

        if (action === 'delete') {
          if (!window.confirm('¿Seguro que deseas eliminar esta experiencia?')) return;
          await deleteExperience(uid);
          if (editingUid === uid && form instanceof HTMLFormElement) {
            form.reset();
            clearExperienceEditState();
          }
          setExperiencesStatus('Experiencia eliminada correctamente.');
          await renderExperiences();
        }
      } catch (error) {
        console.error('Error en acción de experiencia:', error);
        setExperiencesStatus(
          error instanceof Error ? error.message : 'No se pudo completar la acción.',
          'error'
        );
      } finally {
        target.disabled = false;
      }
    });
  }

  // ── Inline image uploaders ──
  const setupImageUploader = (
    btnId: string,
    fileInputId: string,
    urlInputId: string,
    statusId: string,
    storageSuffix: string
  ) => {
    const btn = document.querySelector<HTMLButtonElement>(`#${btnId}`);
    const fileInput = document.querySelector<HTMLInputElement>(`#${fileInputId}`);
    const urlInput = document.querySelector<HTMLInputElement>(`#${urlInputId}`);
    const statusEl = document.querySelector<HTMLElement>(`#${statusId}`);
    if (!btn || !fileInput || !urlInput || !statusEl) return;

    btn.addEventListener('click', () => fileInput.click());

    fileInput.addEventListener('change', async () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      if (!file.type.startsWith('image/')) {
        statusEl.textContent = 'El archivo no es una imagen válida.';
        statusEl.className = 'upload-hint error';
        return;
      }
      btn.disabled = true;
      statusEl.textContent = 'Subiendo imagen…';
      statusEl.className = 'upload-hint';
      try {
        const uploadId = (editingUid || 'upload-' + Date.now()) + storageSuffix;
        const { downloadUrl } = await uploadExperienceImage(uploadId, file);
        urlInput.value = downloadUrl;
        statusEl.textContent = '✓ Imagen subida correctamente';
        statusEl.className = 'upload-hint success';
      } catch (err) {
        statusEl.textContent = err instanceof Error ? err.message : 'Error al subir imagen';
        statusEl.className = 'upload-hint error';
      } finally {
        btn.disabled = false;
        fileInput.value = '';
      }
    });
  };

  setupImageUploader('imageUploadBtn', 'imageFileInput', 'imageUrl', 'imageUploadStatus', '');
  setupImageUploader('secondImageUploadBtn', 'secondImageFileInput', 'secondImageUrl', 'secondImageUploadStatus', '-second');

  if (form instanceof HTMLFormElement && status instanceof HTMLParagraphElement) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.classList.remove('success', 'error');
      status.textContent = editingUid ? 'Actualizando experiencia...' : 'Guardando experiencia...';
      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
      if (cancelEditButton instanceof HTMLButtonElement) cancelEditButton.disabled = true;

      try {
        const wasEditing = Boolean(editingUid);
        const formData = new FormData(form);

        const getString = (key: string) => String(formData.get(key) ?? '').trim();

        // Identity
        const name = getString('name');
        const formatCategory = getString('formatCategory');
        const track = getString('track');
        const origin = getString('origin');

        // Tags
        const tagsInteraction = parseTags(getString('tagsInteraction'));
        const tagsVibe = parseTags(getString('tagsVibe'));
        const tagsCapture = parseTags(getString('tagsCapture'));

        // Content
        const subtitle = getString('subtitle');
        const description = getString('description');
        const keyFeatures = parseFeatures(getString('keyFeatures'));
        const addons = getString('addons');

        // Logistics
        const dimensions = getString('dimensions');
        const power = getString('power');
        const setupTime = getString('setupTime');
        const logisticsConstraints = getString('logisticsConstraints');
        const internet = getString('internet');
        const modality = getString('modality');
        const capacity = getString('capacity');
        const sessionLength = getString('sessionLength');
        const equipmentIncluded = getString('equipmentIncluded');

        // Media
        const videoUrl = getString('videoUrl');
        const photosNeeded = formData.get('photosNeeded') === 'on';

        // Settings
        const visible = formData.get('visible') === 'on';

        if (!name || !formatCategory) {
          throw new Error('Nombre y Categoría/Formato son obligatorios.');
        }

        const uid = editingUid || generateUid(name);
        const editingExperience = editingUid
          ? experiencesCache.find((item) => item.uid === editingUid)
          : null;

        // Images are uploaded inline before submit; just read the URL inputs
        const image = getString('imageUrl') || editingExperience?.image || '';
        const secondImage = getString('secondImageUrl') || editingExperience?.secondImage || '';

        const payload = {
          name,
          formatCategory,
          tagsInteraction,
          tagsVibe,
          tagsCapture,
          track,
          origin,
          subtitle,
          description,
          keyFeatures,
          addons,
          dimensions,
          power,
          setupTime,
          logisticsConstraints,
          internet,
          modality,
          capacity,
          sessionLength,
          equipmentIncluded,
          videoUrl,
          photosNeeded,
          visible,
          image,
          secondImage,
        };

        if (editingUid) {
          await updateExperience(uid, payload);
        } else {
          await createExperience({ uid, ...payload });
        }

        form.reset();
        clearExperienceEditState();
        closeModal();
        await renderExperiences();

        const successMessage = wasEditing ? 'Experiencia actualizada.' : 'Experiencia creada.';
        status.textContent = successMessage;
        status.classList.add('success');
        setExperiencesStatus(successMessage, 'success');
      } catch (error) {
        console.error('Error guardando experiencia:', error);
        const msg = error instanceof Error ? error.message : 'No se pudo guardar la experiencia.';
        status.textContent = msg;
        status.classList.add('error');
        setExperiencesStatus(msg, 'error');
      } finally {
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        if (cancelEditButton instanceof HTMLButtonElement) cancelEditButton.disabled = false;
      }
    });
  }
</script>

